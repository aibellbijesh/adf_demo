{
	"name": "DS_ADLS_CSV_DEMO",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"Container": {
				"type": "string",
				"defaultValue": "adfcontainer"
			},
			"Table_Name": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(toLower(dataset().Table_Name),'_',utcNow())",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@toLower(dataset().Table_Name)",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().Container",
					"type": "Expression"
				}
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}